// Level data. Map legend: '#' solid in every lens, 'A' solid only in the first lens,
// 'B' solid only in the second lens, 'S' straw (collapses when stood on),
// 'P' player start, 'G' goal, '.' empty. Texts: en is required, de and es too (tests check it).
(
    title: (
        en: "Men of straw",
        de: "Strohmänner",
        es: "Hombres de paja",
    ),
    hint: (
        en: "Some ground only looks solid when all you want is to win. Look again.",
        de: "Mancher Boden wirkt nur fest, wenn du bloß gewinnen willst. Schau noch einmal hin.",
        es: "Hay suelo que solo parece firme cuando solo quieres ganar. Vuelve a mirar.",
    ),
    lenses: (
        (
            en: "Win the debate",
            de: "Debatte gewinnen",
            es: "Ganar el debate",
        ),
        (
            en: "Understand the other",
            de: "Andere verstehen",
            es: "Entender al otro",
        ),
    ),
    map: [
        "..............................",
        "..............................",
        "..............................",
        "..............................",
        "..............................",
        "..............................",
