(
    world: (
        en: "The First Crossing",
        de: "Der erste Übergang",
        es: "El primer cruce",
    ),
    title: (
        en: "Either, or…?",
        de: "Entweder, oder …?",
        es: "¿O esto o aquello…?",
    ),
    hint: (
        en: "Two roads are on offer. Are they really the only ones?",
        de: "Zwei Wege werden angeboten. Sind es wirklich die einzigen?",
        es: "Te ofrecen dos caminos. ¿De verdad son los únicos?",
    ),
    lenses: (
        (
            en: "Either/or",
            de: "Entweder/oder",
            es: "O esto o aquello",
        ),
        (
            en: "Look for more",
            de: "Weiter suchen",
            es: "Buscar más",
        ),
    ),
    map: [
        "......................#.......",
        "......................#.......",
        "......................#.......",
        "...............AAAAAAA#.......",
        "......................#.......",
        "...........AA.........#.......",
