// World 2: the traveler enters the perspectives of a sender and a listener.
(
    title: (
        en: "Signal and noise",
        de: "Signal und Rauschen",
        es: "Señal y ruido",
    ),
    hint: (
        en: "A warning crossed the city, but every listener heard it through a different kind of noise.",
        de: "Eine Warnung durchquerte die Stadt, doch jede Person hörte sie durch anderes Rauschen.",
        es: "Una advertencia cruzó la ciudad, pero cada persona la oyó entre un ruido distinto.",
    ),
    lenses: (
        (
            en: "The sender",
            de: "Die sendende Person",
            es: "Quien envía",
        ),
        (
            en: "The listener",
            de: "Die zuhörende Person",
            es: "Quien escucha",
        ),
    ),
    map: [
        "..............................",
        "..............................",
        "..............................",
